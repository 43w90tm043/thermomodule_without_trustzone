                    <item>[[nodiscard]] static error calibrate(command c) noexcept
{
    if (const error e = guard_idle(); e != error::ok) { return e; }
    if (const error e = start_conversion_raw(); e != error::ok) { return e; }

    const uint32_t period = conversion_period_ms(cfg_.dr);

    if (const error e = command_raw(c); e != error::ok) { return e; }

    // A stale "ready" from before the command must not count as completion:
    // let it go inactive first, then wait for the next falling edge.
    const uint32_t t0 = now_ms();
    while (is_data_ready())
    {
        if (now_ms() - t0 &gt;= 2U * period + 50U) { break; }
    }

    if (!wait_drdy(period * 40U + 200U)) { return error::timeout; }  // 16.2 s at 2.5 SPS

    swo::out &lt;&lt; "cal done ms=" &lt;&lt; (now_ms() - t0) &lt;&lt; "\r\n";  // expect ~9200
    return error::ok;
}</item>
                    <item>const auto o0 = Adc::read_register(R::ofcal0);
</item>
                    <item>OFCAL</item>
